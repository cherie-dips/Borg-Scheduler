# Build output (make). It also holds what local runs leave behind:
#   build/cell      binaries, state and logs of a cell started by tools/cell.sh
#   build/ui-smoke  screenshots from tests/ui/browser-smoke.mjs
#   build/results   what borgsim writes when run as the README shows (--out build/results)
build/
*.o
*.d

# Programs compiled by hand, without make: the compiler leaves a.out in this folder, and on a
# Mac a debug build (-g) adds a.out.dSYM/. The README's library example is built this way,
# from an example.cpp that the reader writes here.
*.out
*.dSYM/
/example.cpp

# The Google trace slice: large, and tools/fetch_trace.sh downloads it again
data/

# Logs from local runs (results/run_trace.log stays: it is part of the stored results)
*.log
!results/run_trace.log

# Python (tools/plot.py, tests/e2e_cell.py)
__pycache__/
*.py[cod]
.venv/
venv/

# Node: the page and its tests use no packages, so none belong in the repository
node_modules/

# Local environment and secrets
.env
.env.*

# Editor and IDE settings
.vscode/
*.code-workspace
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
._*
Thumbs.db
